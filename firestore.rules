rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A caller with no profile document yet (first sign-in, before the client
    // writes it) must not error out the whole rule — treat them as unprivileged.
    function hasProfile() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function belongsToOrg(orgId) {
      return hasProfile() && getUserProfile().orgId == orgId;
    }

    function isOwnerOrManager() {
      return getUserProfile().role in ['super_admin', 'owner', 'manager'];
    }

    // Staff roles only. Contractors and tenants also carry the org's orgId (they
    // need it for job/lease context), so belongsToOrg() alone would hand them
    // full staff privileges — always pair it with this for staff-only paths.
    function isStaff() {
      return getUserProfile().role in ['super_admin', 'owner', 'manager', 'leasing_agent', 'maintenance'];
    }

    function isOrgStaff(orgId) {
      return belongsToOrg(orgId) && isStaff();
    }

    // Contractor accounts carry a vendorId linking the login to a Vendor record.
    // get() with a default keeps this from erroring on profiles without the field.
    function callerVendorId() {
      return getUserProfile().get('vendorId', '');
    }

    function isAssignedVendor(vendorId) {
      return hasProfile() && vendorId != null && callerVendorId() == vendorId;
    }

    // Tenant accounts carry a tenantId linking the login to a Tenant record.
    // Rules cannot query, so this is the only way to scope a tenant to their own
    // lease, payments and requests instead of the whole organization's.
    function callerTenantId() {
      return getUserProfile().get('tenantId', '');
    }

    function isSelfTenant(tenantId) {
      return hasProfile() && tenantId != null && callerTenantId() == tenantId;
    }

    // A demo visitor. Anyone can become one by clicking "View Demo" on the
    // marketing site, which mints a token for a single shared identity parked
    // in the demo organization (see api/demo/session).
    //
    // Read-only is enforced by omission and by arithmetic: 'guest' is in none of
    // the staff lists above, carries no tenantId or vendorId, and so satisfies no
    // create, update or delete rule anywhere in this file. The only thing added
    // for it is the ability to look — and only inside the one organization its
    // profile names.
    function isOrgGuest(orgId) {
      return belongsToOrg(orgId) && getUserProfile().role == 'guest';
    }

    // ----- Support access -----
    //
    // A RentOS operator helping a customer. Rather than giving super_admin
    // standing access to every organization — where one stolen session exposes
    // every customer on the platform — access is granted one organization at a
    // time by a document in support_sessions, written only by the Admin SDK.
    //
    // The grant carries an expiry that these rules enforce against request.time,
    // so it lapses on its own, and a writeEnabled flag so looking is the default
    // and editing is a deliberate choice. Deleting the document revokes access
    // immediately; it is the grant itself, not a record of one.
    function supportSession() {
      return get(/databases/$(database)/documents/support_sessions/$(request.auth.uid)).data;
    }

    function hasSupportSession(orgId) {
      return hasProfile()
             && getUserProfile().role == 'super_admin'
             && exists(/databases/$(database)/documents/support_sessions/$(request.auth.uid))
             && supportSession().orgId == orgId
             && request.time < supportSession().expiresAt;
    }

    // Whose eyes the operator is looking through: '' for the customer's staff,
    // or 'tenant' / 'contractor' to be narrowed to one person.
    function supportViewAs(orgId) {
      return hasSupportSession(orgId)
             ? supportSession().get('viewAsRole', '')
             : '';
    }

    /** A support session looking at the org the way its staff do. */
    function supportStaffView(orgId) {
      return hasSupportSession(orgId) && supportViewAs(orgId) == '';
    }

    /**
     * A support session opened with editing allowed.
     *
     * Never while impersonating a tenant or contractor: a record written then
     * would carry that person's name for something they did not do. An operator
     * who needs to fix something does it in the staff view, under their own uid.
     */
    function supportCanWrite(orgId) {
      return supportStaffView(orgId)
             && supportSession().get('writeEnabled', false) == true;
    }

    // The Tenant or Vendor record an operator is looking through, if any.
    //
    // exists() is checked before supportSession() is read, and && short-circuits,
    // so a caller with no session never dereferences a missing document — which
    // would error and deny rather than simply returning "not impersonating".
    function impersonating(role) {
      return hasProfile()
             && getUserProfile().role == 'super_admin'
             && exists(/databases/$(database)/documents/support_sessions/$(request.auth.uid))
             && supportSession().get('viewAsRole', '') == role
             && request.time < supportSession().expiresAt;
    }

    function supportTenantId() {
      return impersonating('tenant')
             ? supportSession().get('viewAsSubjectId', '')
             : '';
    }

    function supportVendorId() {
      return impersonating('contractor')
             ? supportSession().get('viewAsSubjectId', '')
             : '';
    }

    // ----- Reading as somebody else -----
    //
    // The impersonated identity is deliberately confined to `allow read` rules
    // and appears in no write rule anywhere.
    //
    // The first version folded it into callerTenantId(), which every rule uses —
    // and so an operator looking through a tenant's eyes inherited that tenant's
    // right to edit their own contact details. Impersonation must never be able
    // to write: a record changed then carries the customer's name for something
    // they did not do. Keeping it on these read-only helpers is what makes that
    // true by construction rather than by discipline.
    function readerTenantId() {
      return callerTenantId() != '' ? callerTenantId() : supportTenantId();
    }

    function readerVendorId() {
      return callerVendorId() != '' ? callerVendorId() : supportVendorId();
    }

    function viewsAsTenant(tenantId) {
      return hasProfile() && tenantId != null && readerTenantId() == tenantId;
    }

    function viewsAsVendor(vendorId) {
      return hasProfile() && vendorId != null && readerVendorId() == vendorId;
    }

    /** Anyone entitled to look at this organization's operational records. */
    function canViewOrg(orgId) {
      return isOrgStaff(orgId) || isOrgGuest(orgId) || supportStaffView(orgId);
    }

    /** Anyone entitled to change them. */
    function canManageOrg(orgId) {
      return isOrgStaff(orgId) || supportCanWrite(orgId);
    }

    // Whether the organization is still paying for RentOS.
    //
    // Rules cannot count documents, so per-plan unit limits are enforced in the
    // application (see canAddUnit in src/lib/plans.ts). What CAN be enforced
    // here is the thing that must not be bypassable by talking to Firestore
    // directly: an organization whose subscription has ended stops being able
    // to take on new properties, units and leases.
    //
    // Reading and editing existing records is untouched. Locking a landlord out
    // of their own tenancy records over a billing lapse would punish their
    // tenants for something they had no part in.
    //
    // past_due counts as alive: Stripe retries a failed card for weeks before
    // giving up, and only then does the status become canceled.
    function orgBilling(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId))
               .data.get('billing', {});
    }

    function subscriptionAlive(orgId) {
      return orgBilling(orgId).get('status', 'trialing')
             in ['trialing', 'active', 'past_due'];
    }

    /** Entitled to change the org, and the org is entitled to grow. */
    function canProvision(orgId) {
      return canManageOrg(orgId) && subscriptionAlive(orgId);
    }

    // ============================================
    // User Profiles
    // ============================================
    // orgId, role, tenantId and vendorId are the inputs to every authorization
    // decision below. If a caller could write them freely they could simply
    // grant themselves manager access to any organization, which would make the
    // rest of this file decorative.
    //
    // Creation is allowed only into an organization that does not exist yet —
    // i.e. a new signup founding their own org. Joining an EXISTING org must go
    // through the Admin SDK (scripts/link-user-to-org.ts), which bypasses rules.
    match /users/{userId} {
      // Your own profile, always. Org staff may also read the profiles of
      // people in their own organization — the team screen has to be able to
      // list who has access, and an org that cannot see its own members cannot
      // notice a stale one.
      allow read: if isSignedIn()
                  && (request.auth.uid == userId || isOrgStaff(resource.data.orgId));

      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && !exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId));

      // Everything else about a profile is editable; the privilege fields are not.
      //
      // Except for the demo guest, which is a single identity shared by every
      // visitor: one of them renaming it would rename it for all the others.
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && resource.data.role != 'guest'
                    && request.resource.data.orgId == resource.data.orgId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
                    && request.resource.data.get('vendorId', '') == resource.data.get('vendorId', '');
    }

    // ============================================
    // Organizations
    // ============================================
    match /organizations/{orgId} {
      allow read: if belongsToOrg(orgId) || hasSupportSession(orgId);

      // Founding an organization goes through /api/org/create, which uses the
      // Admin SDK. Allowing it from a browser meant a signed-in user could
      // create an org naming anybody as its owner, on any plan, with billing
      // already marked active.
      allow create: if false;

      // Owners and managers maintain the name, timezone and fee settings.
      //
      // The rest is off limits, and each for a concrete reason:
      //   billing  — a client that could write it would grant itself a free
      //              subscription; only the Stripe webhook sets it.
      //   payouts  — this names the Stripe account rent is paid into. Writable
      //              from the browser, it is a redirect-my-tenants'-rent button.
      //   plan     — follows the subscription, not the customer's preference.
      //   ownerId  — whoever holds it cannot be removed or demoted.
      //   slug     — the public URL on their notices and signs; changing it
      //              silently breaks every link already in the world.
      allow update: if (belongsToOrg(orgId) && isOwnerOrManager() || supportCanWrite(orgId))
                    && request.resource.data.get('billing', {}) == resource.data.get('billing', {})
                    && request.resource.data.get('payouts', {}) == resource.data.get('payouts', {})
                    && request.resource.data.get('plan', '') == resource.data.get('plan', '')
                    && request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '')
                    && request.resource.data.get('slug', '') == resource.data.get('slug', '');

      allow delete: if false;
    }

    // ============================================
    // Team Invitations
    // ============================================
    // An invite is a credential: holding one and matching its email address is
    // enough to be admitted to an organization. Staff may read their own org's
    // invites so the team screen can list and revoke them, but no client writes
    // them — issuing, accepting and revoking all go through API routes that
    // verify the caller first. See src/app/api/invites.
    // ============================================
    // Support Access
    // ============================================
    // The live grant an operator is working under. It is the credential, so no
    // client may write it — issuing and ending both go through
    // /api/admin/support-session, which checks the operator's role first. An
    // operator able to write these could grant themselves any customer's data.
    //
    // Readable by its own operator so the app can show what it is acting under
    // and when that lapses.
    match /support_sessions/{adminUid} {
      allow read: if isSignedIn() && request.auth.uid == adminUid;
      allow write: if false;
    }

    // The permanent record of who looked at whose data, when, and why. Written
    // server-side, never readable or writable from a browser: an access log a
    // client could edit is not a log.
    match /support_audit/{entryId} {
      allow read, write: if false;
    }

    // ============================================
    // Product Feedback
    // ============================================
    // Sent from the widget on every screen. Anyone with a real account may
    // write one — a tenant's "I cannot see my lease" is worth more than a
    // manager's relayed version of it — but only about themselves, only into
    // their own organization, and never already answered.
    //
    // Demo visitors are excluded: the demo is open to the internet, and a
    // writable collection reachable without an account is a spam queue.
    match /feedback/{feedbackId} {
      // The submitter, and staff of the organization it came from. Replies come
      // back to the person who asked, which is what makes it worth writing one.
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || isOrgStaff(resource.data.orgId));

      allow create: if hasProfile()
                    && getUserProfile().role != 'guest'
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.orgId == getUserProfile().orgId
                    && request.resource.data.status == 'new'
                    && !('adminNotes' in request.resource.data)
                    && request.resource.data.type
                       in ['bug', 'feature', 'enhancement', 'feedback']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 4000;

      // Triage happens through /api/admin/feedback under the operator role.
      // A client that could write status or adminNotes could answer its own
      // report in our voice.
      allow update, delete: if false;
    }

    match /invites/{inviteId} {
      // Staff only, not canViewOrg: an invite's document id is the token that
      // admits its holder to the organization. A read-only demo visitor being
      // able to list them would be able to join for real.
      allow read: if isOrgStaff(resource.data.orgId);
      allow write: if false;
    }

    // ============================================
    // Properties (staff only)
    // ============================================
    // Tenants have no business enumerating the portfolio. Public browsing of
    // available units happens through /api/public/listing/{id}, which joins an
    // advert to its unit and property server-side.
    match /properties/{propertyId} {
      allow read: if canViewOrg(resource.data.orgId);
      allow create: if canProvision(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Units (staff only)
    // ============================================
    match /units/{unitId} {
      allow read: if canViewOrg(resource.data.orgId);
      allow create: if canProvision(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Tenants
    // ============================================
    // Staff see everyone in the org. A tenant sees only their own record —
    // otherwise every tenant could read every other tenant's email, phone and
    // emergency contact.
    match /tenants/{tenantId} {
      allow read: if canViewOrg(resource.data.orgId) || viewsAsTenant(tenantId);
      allow create: if canManageOrg(request.resource.data.orgId);
      // A tenant may maintain their own contact details, but must not move
      // themselves between organizations.
      allow update: if canManageOrg(resource.data.orgId)
                    || (isSelfTenant(tenantId)
                        && request.resource.data.orgId == resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Leases
    // ============================================
    // A tenant reads only leases they are named on.
    match /leases/{leaseId} {
      allow read: if canViewOrg(resource.data.orgId)
                  || (hasProfile() && readerTenantId() in resource.data.tenantIds);
      allow create: if canProvision(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Applications
    // ============================================
    // Applications from the public go through /api/public/apply, which resolves
    // the organization itself and checks the unit belongs to it. Open creation
    // from the browser let anyone write an application into any organization
    // with any contents — the rules could check little more than "that org
    // exists". Staff still file applications taken over the phone.
    match /applications/{appId} {
      allow read: if canViewOrg(resource.data.orgId);
      allow create: if canManageOrg(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Maintenance Requests
    // ============================================
    // Reports from people with no account — a tenant nobody set up, a passer-by
    // who can see water coming through a ceiling — arrive through
    // /api/public/maintenance, which resolves the organization and checks the
    // property and unit belong to it. Unauthenticated writes straight from the
    // browser could name any org and any building in it.
    //
    // Staff file reports on behalf of callers; a tenant files their own, which
    // is what the tenantId check pins down.
    match /maintenance/{requestId} {
      allow read: if canViewOrg(resource.data.orgId)
                  || viewsAsTenant(resource.data.get('tenantId', ''));
      allow create: if (canManageOrg(request.resource.data.orgId)
                        || (belongsToOrg(request.resource.data.orgId)
                            && isSelfTenant(request.resource.data.get('tenantId', ''))))
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 5000;
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Vendors (staff only)
    // ============================================
    match /vendors/{vendorId} {
      allow read: if canViewOrg(resource.data.orgId) || viewsAsVendor(vendorId);
      allow create: if canManageOrg(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Transactions
    // ============================================
    // The Stripe webhook is the sole writer, and it uses the Admin SDK, which
    // bypasses these rules entirely. No client may write a payment record —
    // otherwise a tenant could insert a completed transaction and mark their own
    // rent paid. Tenants read only their own payment history.
    match /transactions/{txId} {
      allow read: if canViewOrg(resource.data.orgId)
                  || viewsAsTenant(resource.data.get('tenantId', ''));
      allow create, update, delete: if false;
    }

    // ============================================
    // Listings
    // ============================================
    // Not world-readable, despite the advert itself being public. A listing
    // document carries the landlord's sales pipeline alongside the advert: the
    // `leads` array holds enquirers' names, email addresses and phone numbers,
    // and `syndicatedTo`/`socialPosts` record where the vacancy was marketed.
    //
    // The public advert is served by /api/public/listing/{id}, which reads
    // through the Admin SDK and returns only the advertised facts. Leaving the
    // raw document world-readable handed a browser the very fields that route
    // takes care to withhold.
    match /listings/{listingId} {
      allow read: if canViewOrg(resource.data.orgId);
      allow create: if canManageOrg(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Sublets
    // ============================================
    // Tenants create sublets for their own unit from /portal/sublet; managers
    // administer them from /sublets.
    match /sublets/{subletId} {
      allow read: if canViewOrg(resource.data.orgId)
                  || viewsAsTenant(resource.data.get('tenantId', ''));
      allow create: if canManageOrg(request.resource.data.orgId)
                    || (isSelfTenant(request.resource.data.get('tenantId', ''))
                        && belongsToOrg(request.resource.data.orgId));
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Work Orders
    // ============================================
    // Org staff manage all work orders; a contractor reaches only the ones
    // assigned to their own vendor record.
    match /work_orders/{workOrderId} {
      allow read: if canViewOrg(resource.data.orgId)
                  || viewsAsVendor(resource.data.vendorId);
      allow create: if canManageOrg(request.resource.data.orgId);
      // A contractor may report progress, but must not reassign the job to
      // themselves, move it between orgs, or rewrite what it costs.
      allow update: if canManageOrg(resource.data.orgId)
                    || (isAssignedVendor(resource.data.vendorId)
                        && request.resource.data.vendorId == resource.data.vendorId
                        && request.resource.data.orgId == resource.data.orgId
                        && request.resource.data.get('cost', 0) == resource.data.get('cost', 0));
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Inspections
    // ============================================
    // A tenant reads the inspections of their own tenancy — move-in and move-out
    // condition reports are the evidence behind any deposit deduction, so
    // withholding them from the person being charged would be indefensible.
    // Only staff may record findings.
    match /inspections/{inspectionId} {
      allow read: if canViewOrg(resource.data.orgId)
                  || viewsAsTenant(resource.data.get('tenantId', ''));
      allow create: if canManageOrg(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Keys & Lock Changes (staff only)
    // ============================================
    // Who holds which key, and when locks were last changed, is security
    // information about the whole building. Tenants get none of it.
    match /keys/{keyId} {
      allow read: if canViewOrg(resource.data.orgId);
      allow create: if canManageOrg(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    match /lock_changes/{changeId} {
      allow read: if canViewOrg(resource.data.orgId);
      allow create: if canManageOrg(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      // A rekey history that can be edited away is not an audit trail.
      allow delete: if false;
    }

    // ============================================
    // Unit Notes (staff only)
    // ============================================
    // Internal record-keeping, including complaint history about tenants.
    // Never readable by tenants.
    match /unit_notes/{noteId} {
      allow read: if canViewOrg(resource.data.orgId);
      allow create: if canManageOrg(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Calendar (staff only)
    // ============================================
    // The org's operational schedule reveals when units are empty and when
    // people will be on site.
    match /calendar_events/{eventId} {
      allow read: if canViewOrg(resource.data.orgId);
      allow create: if canManageOrg(request.resource.data.orgId);
      allow update: if canManageOrg(resource.data.orgId);
      allow delete: if canManageOrg(resource.data.orgId) && isOwnerOrManager();
    }

    // ============================================
    // Notifications
    // ============================================
    // Written server-side by the Stripe webhook via the Admin SDK. Clients only
    // read their own and mark them read — never create, so a tenant cannot
    // fabricate a "rent received" notice.
    match /notifications/{notificationId} {
      // Staff read everything in their org, including tenant-directed notices —
      // they are about that org's own payments, so there is nothing to hide,
      // and a query scoped only by orgId would otherwise fail wholesale the
      // moment one tenant notification existed. A tenant reads only their own.
      allow read: if canViewOrg(resource.data.orgId)
                  || (resource.data.audience == 'tenant'
                      && viewsAsTenant(resource.data.get('tenantId', '')));

      allow create: if false;

      // Only the read flag may change.
      allow update: if (canManageOrg(resource.data.orgId)
                        || (resource.data.audience == 'tenant'
                            && isSelfTenant(resource.data.get('tenantId', ''))))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['read']);

      allow delete: if canManageOrg(resource.data.orgId);
    }
  }
}
